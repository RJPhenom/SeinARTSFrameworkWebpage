---
import GitHubLabel from './GitHubLabel.astro';
import { GITHUB_URL } from '../config/repository';

const DOCS_URL = 'https://docs.seinarts.gg';
---

<nav class="nav-hidden">
  <div class="inner">
    <a href="#" class="wordmark" aria-label="SeinARTS Framework Home">
      <img src="/branding/SeinARTSWordmarkVectorized.svg" alt="SeinARTS Framework" />
    </a>
    <button
      class="menu-toggle"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="nav-links"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
    <ul class="links" id="nav-links" role="list">
      <li><a href="/#media">Media</a></li>
      <li><a href="/#changelog">Releases</a></li>
      <li>
        <a href={DOCS_URL} target="_blank" rel="noopener noreferrer" class="link-docs">
          Docs
        </a>
      </li>
      <li>
        <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer">
          <GitHubLabel />
        </a>
      </li>
    </ul>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    min-height: var(--nav-h);
    background: var(--bg);
    border-bottom: 1px solid #191919;
    opacity: 0;
    transform: translateY(-100%);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  nav.visible,
  nav:focus-within {
    opacity: 1;
    transform: translateY(0);
  }

  .inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0.5rem 1rem;
    min-height: calc(var(--nav-h) + 2rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .wordmark img {
    display: block;
    height: 40px;
    width: auto;
    margin: 0;
    position: static;
    transition: opacity 0.2s;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    margin: 0.5rem 0;
    cursor: pointer;
  }

  .wordmark:hover img {
    opacity: 0.7;
  }

  .links {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }

  .menu-toggle {
    display: none;
    width: 2.5rem;
    height: 2.5rem;
    border: none;
    background: rgba(255, 255, 255, 0.01);
    color: var(--white);
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.26rem;
    cursor: pointer;
  }

  .menu-toggle span {
    width: 1rem;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 300;
    color: var(--white);
    border: 1px solid transparent;
    background: transparent;
    transition: background 0.2s;
  }

  .links a:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 600px) {
    .menu-toggle {
      display: inline-flex;
    }

    .inner {
      position: relative;
      padding: 0.25rem 1rem;
    }

    .wordmark {
      margin-left: 0;
    }

    .links {
      position: absolute;
      top: calc(100% + 0.35rem);
      right: 1rem;
      min-width: 11rem;
      padding: 0.5rem;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      border: 1px solid var(--border);
      background: rgba(0, 0, 0, 0.96);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      opacity: 0;
      transform: translateY(-8px);
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s ease;
      z-index: 110;
    }

    nav.menu-open .links {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
      pointer-events: auto;
    }

    .links a {
      width: 100%;
      justify-content: flex-start;
    }

    nav.menu-open .menu-toggle span:nth-child(1) {
      transform: translateY(6px) rotate(45deg);
    }

    nav.menu-open .menu-toggle span:nth-child(2) {
      opacity: 0;
    }

    nav.menu-open .menu-toggle span:nth-child(3) {
      transform: translateY(-6px) rotate(-45deg);
    }
  }
</style>

<script>
  const nav = document.querySelector('nav');
  const wordmark = document.querySelector('.wordmark');
  const menuToggle = document.querySelector('.menu-toggle');
  const navLinks = document.querySelector('.links');

  function closeMenu() {
    nav?.classList.remove('menu-open');
    menuToggle?.setAttribute('aria-expanded', 'false');
  }

  menuToggle?.addEventListener('click', () => {
    const isOpen = nav?.classList.toggle('menu-open') ?? false;
    menuToggle?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
  });

  navLinks?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (window.innerWidth <= 600) {
        closeMenu();
      }
    });
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 600) {
      closeMenu();
    }
  });

  function onScroll() {
    if (window.scrollY >= 250) {
      nav?.classList.add('visible');
    } else {
      nav?.classList.remove('visible');
    }
  }

  wordmark?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    if (window.innerWidth <= 600) {
      closeMenu();
    }
  });

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
