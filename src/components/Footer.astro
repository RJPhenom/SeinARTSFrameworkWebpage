---
import phenomWordmarkUrl from '../../branding/PhenomWordmark.svg?url';
import GitHubLabel from './GitHubLabel.astro';
import { GITHUB_URL } from '../config/repository';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <nav class="footer-links" aria-label="Footer navigation">
    <a href="/#media">Media</a>
    <a href="/#changelog">Releases</a>
    <a href="https://docs.seinarts.gg" target="_blank" rel="noopener noreferrer">Docs</a>
    <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer"><GitHubLabel /></a>
  </nav>
  <div class="phenom-credit">
    <img src={phenomWordmarkUrl} alt="Phenom Studios" width="912" height="201" />
    <span>&copy; {year}. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: min(70rem, calc(100% - 2rem));
    margin: 1.5rem auto 0;
    padding: 0;
  }

  .footer-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid transparent;
    color: var(--text-muted);
    font-size: 0.875rem;
    font-weight: 300;
  }

  .footer-links a:hover,
  .footer-links a:hover :global(.github-label > span) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .phenom-credit {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
    width: 100%;
    padding-block: 0.75rem 0.25rem;
    color: #a3a3a3;
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.75;
    text-align: center;
  }

  .phenom-credit img {
    display: block;
    flex: none;
    width: auto;
    height: 1.75rem;
  }
</style>
