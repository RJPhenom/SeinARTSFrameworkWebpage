---
import phenomWordmarkUrl from '../../branding/PhenomWordmark.svg?url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="phenom-credit">
    <img src={phenomWordmarkUrl} alt="Phenom Studios" width="912" height="201" />
    <span>&copy; {year}. All rights reserved.</span>
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: min(70rem, calc(100% - 2rem));
    margin: 1.5rem auto 0;
    padding: 0;
  }

  .phenom-credit {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
    width: 100%;
    padding-block: 0.75rem 0.25rem;
    color: #a3a3a3;
    font-size: 0.875rem;
    font-weight: 300;
    line-height: 1.75;
    text-align: center;
  }

  .phenom-credit img {
    display: block;
    flex: none;
    width: auto;
    height: 1.75rem;
  }
</style>
