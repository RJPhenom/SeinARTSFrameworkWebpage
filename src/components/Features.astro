---
const features = [
  {
    title: 'Deterministic Simulation',
    description:
      'Build gameplay on fixed-point math and repeatable simulation ticks. The same starting state and commands produce the same result.',
    accent: 'red',
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 2L18 10L10 18L2 10L10 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="10" cy="10" r="2.5" fill="currentColor"/></svg>`,
  },
  {
    title: 'Lockstep Networking',
    description:
      'Keep multiplayer traffic focused on player commands. Each client runs the simulation locally, so ordinary unit movement doesn’t need a stream of position updates.',
    accent: 'blue',
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 10H17M17 10L13 6M17 10L13 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 10H3M3 10L7 6M3 10L7 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.8"/></svg>`,
  },
  {
    title: 'Unreal Engine Workflow',
    description:
      'Create units and abilities in Blueprint, and extend the framework in C++. Keep using Unreal’s editor, rendering, and asset pipeline.',
    accent: 'red',
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="3" y="3" width="14" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/><path d="M7 10L9.5 12.5L13 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'Match Replays',
    description:
      'Record the commands behind a match and play it back. Use replays to review a battle or reproduce a problem during development.',
    accent: 'blue',
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 10C4 6.686 6.686 4 10 4a6 6 0 0 1 5.196 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M15.196 7V3.5H18.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.4"/><path d="M16 10c0 3.314-2.686 6-6 6s-6-2.686-6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
  },
  {
    title: 'Blueprint Ability System',
    description:
      'Script your simulation with abilities, effects, attributes, and gameplay tags. Bring them together in Blueprint to define how units move, fight, and interact.',
    accent: 'red',
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 4L16 10L7 16V4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>`,
  },
  {
    title: 'Optional Extensions',
    description:
      'Start with the core framework. Add squads, cover, movement modes, and online services through separate plugins, each with a clear role in your game.',
    accent: 'blue',
    icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="2" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="2" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="11" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/><rect x="11" y="11" width="7" height="7" rx="1.5" stroke="currentColor" stroke-width="1.5"/></svg>`,
  },
];
---

<section class="features section" id="features">
  <div class="section-inner">
    <div class="section-header">
      <h2>Unreal Engine RTS Development</h2>
      <p class="subtitle">
        Everything you need to build a competitive real-time strategy game on Unreal Engine 5.
      </p>
    </div>

    <div class="grid">
      {
        features.map((f) => (
          <div class={`card accent-${f.accent}`}>
            <div class="card-header">
              <div class={`card-icon accent-${f.accent}`} set:html={f.icon} />
              <h3>{f.title}</h3>
            </div>
            <p>{f.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  @media (min-width: 50rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
      padding-bottom: 5rem;
    }

    .card:nth-child(even) {
      transform: translateY(5rem);
    }
  }

  .card {
    --card-accent: var(--red);
    --card-tint: rgba(255, 0, 0, 0.045);
    padding: clamp(1rem, calc(0.125rem + 3vw), 2.5rem);
    border: 1px solid var(--border);
    background: linear-gradient(145deg, var(--card-tint), var(--bg) 72%);
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }

  .card.accent-blue {
    --card-accent: var(--blue);
    --card-tint: rgba(0, 149, 255, 0.055);
  }

  .card:hover {
    border-color: var(--card-accent);
    box-shadow: inset 0 0 0 1px var(--card-accent);
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(0.5rem, calc(0.125rem + 1vw), 1rem);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    padding: 0.3rem;
    border: 1px solid var(--card-accent);
    background: var(--card-tint);
    color: var(--white);
    line-height: 1;
  }

  h3 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: normal;
    line-height: 1.2;
    margin-bottom: 0;
  }

  p {
    color: var(--text);
    font-size: clamp(0.875rem, calc(0.5rem + 1vw), 1rem);
    line-height: 1.75;
  }

</style>
