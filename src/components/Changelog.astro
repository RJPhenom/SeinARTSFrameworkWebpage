---
import GitHubLabel from './GitHubLabel.astro';
import { RELEASES_URL, RELEASES_API_URL } from '../config/repository';

interface GithubRelease {
  tag_name: string;
  name: string;
  published_at: string;
  body: string;
  html_url: string;
  prerelease: boolean;
  draft: boolean;
}

let releases: GithubRelease[] = [];
let fetchError = false;

try {
  const res = await fetch(RELEASES_API_URL, {
    headers: { 'Accept': 'application/vnd.github+json' },
  });
  if (res.ok) {
    const data: GithubRelease[] = await res.json();
    releases = data.filter((r) => !r.draft && !r.prerelease).slice(0, 5);
  } else {
    fetchError = true;
  }
} catch {
  fetchError = true;
}

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function parseNotes(body: string): string[] {
  return body
    .split('\n')
    .map((l) => l.replace(/^[-*]\s+/, '').trim())
    .filter((l) => l.length > 0 && !l.startsWith('#'));
}
---

<section class="changelog section" id="changelog">
  <div class="section-inner">
    <div class="section-header">
      <h2>Latest Releases</h2>
    </div>

    <div class="releases">
      {fetchError && (
        <p class="empty">Releases are temporarily unavailable.</p>
      )}
      {!fetchError && releases.length === 0 && (
        <p class="empty">No releases yet — check back soon.</p>
      )}
      {releases.map((r) => (
        <div class="release">
          <div class="release-meta">
            <span class="version">{r.tag_name}</span>
            <span class="release-tag">{r.name}</span>
            <time class="date" datetime={r.published_at}>{formatDate(r.published_at)}</time>
          </div>
          {r.body && (
            <ul class="notes" role="list">
              {parseNotes(r.body).map((note) => (
                <li>
                  <span class="bullet" aria-hidden="true" />
                  {note}
                </li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </div>

    <div class="view-all">
      <a href={RELEASES_URL} target="_blank" rel="noopener noreferrer" class="view-all-link">
        <GitHubLabel><span class="link-text">View all releases on GitHub</span></GitHubLabel>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>

  .releases {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .empty {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.9rem;
    padding: 3rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0;
  }

  .release {
    overflow-wrap: anywhere;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 0;
    padding: 1.75rem 2rem;
  }

  .release-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .version {
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.015em;
    color: var(--white);
  }

  .release-tag {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--red);
    background: rgba(255, 0, 0, 0.09);
    border: 1px solid rgba(255, 0, 0, 0.2);
    padding: 0.2rem 0.6rem;
    border-radius: 0;
  }

  .date {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-left: auto;
  }

  .notes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .notes li {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .bullet {
    flex-shrink: 0;
    width: 5px;
    height: 5px;
    border-radius: 0;
    background: var(--blue);
    margin-top: 0.55em;
  }

  .view-all {
    text-align: center;
    margin-top: 2rem;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--blue);
    transition: color 160ms ease;
  }

  .view-all-link:hover {
    color: var(--blue);
  }

  .view-all-link:hover .link-text {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

</style>
