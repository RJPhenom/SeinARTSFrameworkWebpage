---
import GitHubLabel from './GitHubLabel.astro';
import { GITHUB_URL } from '../config/repository';
---

<section class="media section" id="media">
  <div class="section-inner">
    <div class="section-header">
      <h2>See it in action</h2>
    </div>

    <div class="placeholder">
      <div class="placeholder-content">
        <svg
          class="placeholder-icon"
          width="44"
          height="44"
          viewBox="0 0 24 24"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <rect x="2" y="4" width="20" height="14" rx="2.5" stroke="currentColor" stroke-width="1.25"/>
          <path d="M9.5 9L15.5 12L9.5 15V9Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
          <path d="M8 21H16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          <path d="M12 18V21" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
        <p class="placeholder-text">Screenshots &amp; video coming soon.</p>
        <p class="placeholder-sub">
          Follow progress on the{' '}
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer"><GitHubLabel>GitHub repo</GitHubLabel></a>.
        </p>
      </div>
    </div>
  </div>
</section>

<!--
  To add screenshots: replace the placeholder div above with an image grid, e.g.:

  <div class="screenshot-grid">
    <img src="/media/screenshot-1.png" alt="…" />
    <img src="/media/screenshot-2.png" alt="…" />
  </div>
-->

<style>

  .placeholder {
    border: 1px solid var(--border);
    border-radius: 0;
    min-height: 16rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface);
  }

  .placeholder-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding: 2rem 1rem;
    text-align: center;
  }

  .placeholder-icon {
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .placeholder-text {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .placeholder-sub {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .placeholder-sub a {
    color: var(--blue);
    transition: opacity 0.2s;
  }

  .placeholder-sub a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Screenshot grid — used when replacing the placeholder */
  .screenshot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
    gap: 1rem;
  }

  .screenshot-grid img {
    width: 100%;
    border-radius: 0;
    border: 1px solid var(--border);
    display: block;
  }

</style>
