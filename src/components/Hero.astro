---
import GitHubLabel from './GitHubLabel.astro';
import { GITHUB_URL } from '../config/repository';

const DOCS_URL = 'https://docs.seinarts.gg';
---

<section class="hero">
  <canvas class="bg-grid" aria-hidden="true"></canvas>
  <div class="bg-glow" aria-hidden="true"></div>

  <div class="content">
    <div class="wordmark-wrap">
      <img
        src="/branding/SeinARTSWordmarkVectorized.svg?v=20260415b"
        alt="SeinARTS Framework"
        class="wordmark"
        height="38"
      />
      <p class="brand-credit">
        <span>By</span>
        <img src="/branding/PhenomWordmark.svg" alt="Phenom Studios" width="912" height="201" />
      </p>
    </div>

    <div class="ctas">
      <a href={DOCS_URL} target="_blank" rel="noopener noreferrer" class="btn btn-docs">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M4 6h16M4 10h16M4 14h10M4 18h7" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
        Docs
      </a>
      <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="btn btn-github">
        <GitHubLabel />
      </a>
    </div>

    <p class="meta-badge">Unreal Engine 5 &nbsp;·&nbsp; Open Source</p>

    <a href="/#features" class="scroll-next" aria-label="Scroll to Features section">
      <span aria-hidden="true" class="scroll-next-arrow">↓</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: calc(var(--nav-h) + 2rem) 2rem 3.5rem;
  }

  /* Dot grid background */
  .bg-grid {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    width: 100%;
    height: 100%;
    pointer-events: none;
    mask-image: radial-gradient(
      ellipse 85% 85% at 50% 50%,
      black 30%,
      transparent 100%
    );
  }

  /* The docs homepage uses a restrained red-to-blue brand wash. */
  .bg-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 45%, rgba(255, 255, 255, 0.045), transparent 16rem),
      linear-gradient(90deg, rgba(255, 0, 0, 0.16), rgba(0, 0, 0, 0.99) 47%, rgba(0, 149, 255, 0.12));
    pointer-events: none;
  }

  .content {
    position: relative;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-width: 620px;
  }

  .wordmark-wrap {
    display: grid;
    justify-items: end;
    gap: 1.1rem;
    line-height: 1;
  }

  .brand-credit {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding-inline-end: 0.25rem;
    color: var(--text-muted);
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.08em;
    line-height: 1;
  }

  .brand-credit img {
    display: block;
    width: auto;
    height: 1.05rem;
  }

  .wordmark {
    height: auto;
    width: min(27rem, calc(100vw - 4rem));
    display: block;
  }

  .ctas {
    display: flex;
    gap: 1.25rem;
    flex-wrap: nowrap;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    min-width: 124px;
    min-height: 2.75rem;
    padding: 0.625rem 1.125rem;
    border-radius: 0;
    border: 1px solid transparent;
    background: transparent;
    color: var(--white);
    font-size: 1rem;
    font-weight: 300;
    font-family: inherit;
    letter-spacing: 0;
    transition:
      background 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .btn svg {
    width: 17px;
    height: 17px;
  }

  .btn-docs {
    background: var(--white);
    color: var(--bg);
  }

  .btn-docs:hover {
    background: #e6e6e6;
  }

  .btn-github {
    background: transparent;
  }

  .btn-github:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .meta-badge {
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 300;
    margin-top: 0.25rem;
  }

  .scroll-next {
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
    flex-shrink: 0;
  }

  .scroll-next:hover {
    background: rgba(255, 255, 255, 0.12);
    color: var(--white);
  }

  .scroll-next-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    font-size: 1.5rem;
    line-height: 1;
  }

  @media (max-width: 32rem) {
    .ctas {
      gap: 0.5rem;
    }

    .btn {
      min-width: 7rem;
      padding-inline: 0.75rem;
    }

    .hero {
      padding: calc(var(--nav-h) + 1.25rem) 1.25rem 2.25rem;
    }
  }

</style>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const gridCanvas = document.querySelector<HTMLCanvasElement>('.bg-grid');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero && gridCanvas) {
    const heroEl = hero;
    const canvasEl = gridCanvas;
    const context = canvasEl.getContext('2d');

    if (context) {
      const ctx = context;
      const spacing = 36;
      const baseRadius = 1;
      const influenceRadius = 180;
      const pullStrength = 16;
      const driftPixelsPerMs = (36 * 3) / 26000;
      const maxDpr = 2;
      const pointer = {
        x: 0,
        y: 0,
        active: false,
      };

      let width = 0;
      let height = 0;
      let devicePixelRatioValue = 1;
      let animationFrameId = 0;
      let dots: Array<{ x: number; y: number }> = [];

      function rebuildDots() {
        dots = [];

        for (let y = -spacing; y <= height + spacing; y += spacing) {
          for (let x = -spacing; x <= width + spacing; x += spacing) {
            dots.push({ x, y });
          }
        }
    }

      function resizeCanvas() {
        const bounds = heroEl.getBoundingClientRect();

        width = bounds.width;
        height = bounds.height;
        devicePixelRatioValue = Math.min(window.devicePixelRatio || 1, maxDpr);

        canvasEl.width = Math.round(width * devicePixelRatioValue);
        canvasEl.height = Math.round(height * devicePixelRatioValue);
        ctx.setTransform(devicePixelRatioValue, 0, 0, devicePixelRatioValue, 0, 0);

        rebuildDots();
      }

      function updatePointer(event: PointerEvent) {
        const bounds = heroEl.getBoundingClientRect();
        pointer.x = event.clientX - bounds.left;
        pointer.y = event.clientY - bounds.top;
        pointer.active = true;
      }

      function resetPointer() {
        pointer.active = false;
      }

      function drawFrame(timestamp: number) {
        ctx.clearRect(0, 0, width, height);

        const pulse = reduceMotion.matches ? 1 : 0.92 + Math.sin(timestamp * 0.0011) * 0.08;
        const driftOffset = reduceMotion.matches ? 0 : (timestamp * driftPixelsPerMs) % spacing;

        for (const dot of dots) {
          let drawX = dot.x + driftOffset;
          let drawY = dot.y + driftOffset;
          let dotRadius = baseRadius;
          let alpha = 0.19 * pulse;

          if (pointer.active && !reduceMotion.matches) {
            const deltaX = pointer.x - dot.x;
            const deltaY = pointer.y - dot.y;
            const distance = Math.hypot(deltaX, deltaY);

            if (distance < influenceRadius && distance > 0.001) {
              const falloff = 1 - distance / influenceRadius;
              const force = falloff * falloff;

              drawX += (deltaX / distance) * pullStrength * force;
              drawY += (deltaY / distance) * pullStrength * force;
              dotRadius += force * 0.65;
              alpha += force * 0.22;
            }
          }

          ctx.beginPath();
          ctx.arc(drawX, drawY, dotRadius, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(255, 255, 255, ${Math.min(alpha, 0.42)})`;
          ctx.fill();
        }

        animationFrameId = window.requestAnimationFrame(drawFrame);
      }

      resizeCanvas();
      animationFrameId = window.requestAnimationFrame(drawFrame);

      if (!reduceMotion.matches) {
        heroEl.addEventListener('pointermove', updatePointer, { passive: true });
        heroEl.addEventListener('pointerleave', resetPointer, { passive: true });
      }

      window.addEventListener('resize', resizeCanvas);
      reduceMotion.addEventListener('change', resetPointer);
      window.addEventListener('pagehide', () => window.cancelAnimationFrame(animationFrameId), {
        once: true,
      });
    }
  }
</script>
